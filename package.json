{
  "name": "daygle-ai-camera-frontend",
  "private": true,
  "description": "Lint and test tooling for the Daygle AI Camera dashboard frontend (web/).",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "coverage:js": "c8 --include web/ --reporter=text --reporter=lcov node --test --test-reporter=spec \"tests/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
