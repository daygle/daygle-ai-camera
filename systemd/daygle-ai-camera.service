[Unit]
Description=Daygle AI Camera FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daygle
Group=daygle
WorkingDirectory=/opt/daygle-ai-camera
Environment=DAYGLE_CONFIG=/etc/daygle-ai-camera/config.yaml
Environment=PYTHONUNBUFFERED=1
# --proxy-headers makes request.url honour X-Forwarded-Proto/Host from a
# reverse proxy so HSTS, redirects, and the same-origin CSRF guard see the
# external scheme/host. --forwarded-allow-ips defaults to loopback for a
# same-host proxy; set it to the reverse proxy's IP (and add that IP to
# auth.trusted_proxies in config.yaml) for a proxy on a separate host/container.
ExecStart=/opt/daygle-ai-camera/.venv/bin/python -m app.server
Restart=on-failure
RestartSec=5

# Minimal sandboxing (safe + compatible)
ReadWritePaths=/etc/daygle-ai-camera /opt/daygle-ai-camera/data

[Install]
WantedBy=multi-user.target
